msgid ""
"image, video, text, shape, solid, spectrum, particles, sound, group, "
"adjustment, mesh, model, light or group3d"
msgstr ""
"image, video, text, shape, solid, spectrum, particles, sound, group, "
"adjustment, mesh, model, light o group3d"

