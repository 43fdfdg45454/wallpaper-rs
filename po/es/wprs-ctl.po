#: apps/wprs-ctl/src/limbing.rs
msgid "Change chain N, 0 first"
msgstr "Cambiar la cadena N, 0 la primera"

#: apps/wprs-ctl/src/limbing.rs
msgid "The chain, 0 first"
msgstr "La cadena, 0 la primera"

#: apps/wprs-ctl/src/limbing.rs
msgid "Another first bone, given with --tip"
msgstr "Otro primer hueso, junto con --tip"

#: apps/wprs-ctl/src/limbing.rs
msgid "Another last bone, given with --root"
msgstr "Otro último hueso, junto con --root"

#: apps/wprs-ctl/src/limbing.rs
msgid "Remove chain N, 0 first"
msgstr "Quitar la cadena N, 0 la primera"

