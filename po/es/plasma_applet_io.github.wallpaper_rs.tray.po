#: integrations/plasma-tray/contents/ui/Consent.qml
msgid "Follow the sound that plays"
msgstr "Seguir el sonido que se reproduce"

#: integrations/plasma-tray/contents/ui/Consent.qml
msgid ""
"The sound is turned into levels on this computer while the scene is shown; "
"nothing is recorded, kept or sent, and the desktop may show a microphone "
"indicator."
msgstr ""
"Mientras se muestra la escena, el sonido se convierte en niveles en este "
"equipo; no se graba, no se guarda ni se envía, y el escritorio puede mostrar "
"un indicador de micrófono."

#: integrations/plasma-tray/contents/ui/Consent.qml
msgid "Follow the pointer"
msgstr "Seguir el puntero"

#: integrations/plasma-tray/contents/ui/Consent.qml
msgid ""
"Only the latest pointer position over this screen reaches the scene; "
"positions are never kept and keys are never read."
msgstr ""
"A la escena solo le llega la última posición del puntero sobre esta "
"pantalla; las posiciones nunca se guardan y las teclas nunca se leen."

#: integrations/plasma-tray/contents/ui/Consent.qml
msgid "Take clicks and taps"
msgstr "Recibir clics y toques"

#: integrations/plasma-tray/contents/ui/Consent.qml
msgid ""
"Only real clicks and taps on the wallpaper of this screen reach the scene; "
"they are never kept and keys are never read."
msgstr ""
"Solo llegan a la escena los clics y toques reales sobre el fondo de esta "
"pantalla; nunca se guardan y nunca se leen las teclas."

#: integrations/plasma-tray/contents/ui/Consent.qml
#, kde-format
msgid "The scene %1 asks for your permission:"
msgstr "La escena %1 te pide permiso:"

#: integrations/plasma-tray/contents/ui/Consent.qml
msgid "Confirm it in the desktop notification."
msgstr "Confírmalo en la notificación del escritorio."

#: integrations/plasma-tray/contents/ui/Consent.qml
msgid ""
"The notification was closed without an answer; try again in a few minutes."
msgstr ""
"La notificación se cerró sin respuesta; vuelve a intentarlo dentro de unos "
"minutos."

#: integrations/plasma-tray/contents/ui/Consent.qml
msgid "Allow"
msgstr "Permitir"

#: integrations/plasma-tray/contents/ui/Consent.qml
msgid "Not now"
msgstr "Ahora no"

#: integrations/plasma-tray/contents/ui/Daemon.qml
#, kde-format
msgid "The wallpaper-rs daemon is not running"
msgstr "El servicio de wallpaper-rs no se está ejecutando"

#: integrations/plasma-tray/contents/ui/Daemon.qml
#, kde-format
msgid "wallpaper-rs could not be opened"
msgstr "No se pudo abrir wallpaper-rs"

#: integrations/plasma-tray/contents/ui/Header.qml
#, kde-format
msgid "Resume"
msgstr "Reanudar"

#: integrations/plasma-tray/contents/ui/Header.qml
#, kde-format
msgid "Pause"
msgstr "Pausar"

#: integrations/plasma-tray/contents/ui/Header.qml
#, kde-format
msgid "Unmute"
msgstr "Activar el sonido"

#: integrations/plasma-tray/contents/ui/Header.qml
#, kde-format
msgid "Mute"
msgstr "Silenciar"

#: integrations/plasma-tray/contents/ui/Header.qml
#, kde-format
msgid "Let scenes play their sounds"
msgstr "Dejar que las escenas reproduzcan sus sonidos"

#: integrations/plasma-tray/contents/ui/Header.qml
#, kde-format
msgid "Let scenes react to the sound that plays"
msgstr "Dejar que las escenas reaccionen al sonido que suena"

#: integrations/plasma-tray/contents/ui/Header.qml
#, kde-format
msgid "Slow down or stop wallpapers that flash more than three times a second"
msgstr ""
"Frenar o detener los fondos que destellan más de tres veces por segundo"

#: integrations/plasma-tray/contents/ui/Header.qml
#, kde-format
msgid "No profile"
msgstr "Sin perfil"

#: integrations/plasma-tray/contents/ui/Header.qml
#, kde-format
msgid "Profile: %1"
msgstr "Perfil: %1"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "it is too slow for this graphics card"
msgstr "es demasiado lento para esta tarjeta gráfica"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "it stopped the graphics card or the program twice"
msgstr "detuvo dos veces la tarjeta gráfica o el programa"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid ""
"the graphics card or the program stopped twice while it built or drew this "
"effect"
msgstr ""
"la tarjeta gráfica o el programa se detuvo dos veces mientras preparaba o "
"dibujaba este efecto"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "the graphics card or the program stopped while it drew this effect"
msgstr ""
"la tarjeta gráfica o el programa se detuvo mientras dibujaba este efecto"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "it kept the graphics card busy for too long"
msgstr "mantuvo ocupada la tarjeta gráfica demasiado tiempo"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "its shader could not be checked"
msgstr "no se pudo revisar su shader"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid ""
"the effects of the scene would do more work than this graphics card allows"
msgstr "la escena haría más trabajo del que permite esta tarjeta gráfica"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "the scene has more than 16 effects that keep a state"
msgstr "la escena tiene más de 16 efectos que guardan un estado"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "its state textures would take too much memory"
msgstr "sus texturas de estado ocuparían demasiada memoria"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "its textures would take too much memory"
msgstr "sus texturas ocuparían demasiada memoria"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "The effect %1 was left out: %2"
msgstr "Se omitió el efecto %1: %2"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "your time zone"
msgstr "tu zona horaria"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "your language"
msgstr "tu idioma"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "what your graphics card can do"
msgstr "lo que puede hacer tu tarjeta gráfica"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "data it keeps on this computer"
msgstr "datos que guarda en este equipo"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "the network, to reach the sites it names"
msgstr "la red, para llegar a los sitios que nombra"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid ""
"This web wallpaper uses %1. You can restrict each of them in its settings in "
"the app."
msgstr ""
"Este fondo web usa %1. Puedes restringir cada cosa en sus ajustes de la app."

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "Its web engine runs without part of its sandbox on this computer."
msgstr "Su motor web funciona sin parte de su aislamiento en este equipo."

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "the most this graphics card allows"
msgstr "lo máximo que permite esta tarjeta gráfica"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "lowered because the scene is heavy for this graphics card"
msgstr "rebajada porque la escena pesa demasiado para esta tarjeta gráfica"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "lowered on battery"
msgstr "rebajada con batería"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "lowered while saving power"
msgstr "rebajada mientras se ahorra energía"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "lowered while the computer is hot"
msgstr "rebajada mientras el equipo está caliente"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "lowered because its frames took too long on the graphics card"
msgstr ""
"rebajada porque sus fotogramas tardaban demasiado en la tarjeta gráfica"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "Quality %1 of 3"
msgstr "Calidad %1 de 3"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "graphics card class %1 of 3, measured"
msgstr "tarjeta gráfica de clase %1 de 3, medida"

#: integrations/plasma-tray/contents/ui/LeftOut.qml
#, kde-format
msgid "graphics card class %1 of 3, from its model"
msgstr "tarjeta gráfica de clase %1 de 3, según su modelo"

#: integrations/plasma-tray/contents/ui/Panel.qml
#, kde-format
msgid "No screen shows wallpaper-rs"
msgstr "Ninguna pantalla muestra wallpaper-rs"

#: integrations/plasma-tray/contents/ui/Panel.qml
#, kde-format
msgid "Choose wallpaper-rs as the wallpaper type in the desktop settings."
msgstr "Elige wallpaper-rs como tipo de fondo en los ajustes del escritorio."

#: integrations/plasma-tray/contents/ui/Panel.qml
#, kde-format
msgid "Change the other settings with wprs-ctl"
msgstr "Cambia los demás ajustes con wprs-ctl"

#: integrations/plasma-tray/contents/ui/Panel.qml
#, kde-format
msgid "Open wallpaper-rs"
msgstr "Abrir wallpaper-rs"

#: integrations/plasma-tray/contents/ui/Panel.qml
#, kde-format
msgid "Settings…"
msgstr "Ajustes…"

#: integrations/plasma-tray/contents/ui/ScreenButtons.qml
#, kde-format
msgid "Next"
msgstr "Siguiente"

#: integrations/plasma-tray/contents/ui/ScreenButtons.qml
#, kde-format
msgid "Choose…"
msgstr "Elegir…"

#: integrations/plasma-tray/contents/ui/ScreenButtons.qml
#, kde-format
msgid "Favorite"
msgstr "Favorito"

#: integrations/plasma-tray/contents/ui/ScreenButtons.qml
#, kde-format
msgid "Remove from favorites"
msgstr "Quitar de favoritos"

#: integrations/plasma-tray/contents/ui/ScreenButtons.qml
#, kde-format
msgid "Add to favorites"
msgstr "Añadir a favoritos"

#: integrations/plasma-tray/contents/ui/ScreenButtons.qml
#, kde-format
msgid "Images and videos"
msgstr "Imágenes y vídeos"

#: integrations/plasma-tray/contents/ui/ScreenRow.qml
#, kde-format
msgid "Background color"
msgstr "Color de fondo"

#: integrations/plasma-tray/contents/ui/ScreenRow.qml
#, kde-format
msgid "%1 of %2"
msgstr "%1 de %2"

#: integrations/plasma-tray/contents/ui/ScreenRow.qml
#, kde-format
msgid "Its particles run on the processor, so fewer of them are shown"
msgstr "Sus partículas se mueven en el procesador, así que se muestran menos"

#: integrations/plasma-tray/contents/ui/ScreenRow.qml
#, kde-format
msgid "Let clicks and taps on this screen reach its wallpaper"
msgstr "Dejar que los clics y toques de esta pantalla lleguen a su fondo"

#: integrations/plasma-tray/contents/ui/ScreenRow.qml
#, kde-format
msgid "Flashes or shows fast patterns; you allowed it"
msgstr "Destella o muestra patrones rápidos; lo has permitido"

#: integrations/plasma-tray/contents/ui/ScreenRow.qml
#, kde-format
msgid "Flashes or shows fast patterns that can trigger seizures"
msgstr ""
"Destella o muestra patrones rápidos que pueden provocar crisis epilépticas"

#: integrations/plasma-tray/contents/ui/Thumbnail.qml
#, kde-format
msgid "Mature content: click the picture to always show this package"
msgstr ""
"Contenido para adultos: haz clic en la imagen para mostrar siempre este "
"paquete"

#: integrations/plasma-tray/contents/ui/main.qml
#, kde-format
msgid "Paused"
msgstr "En pausa"

#: integrations/plasma-tray/contents/ui/main.qml
#, kde-format
msgid "Playing"
msgstr "Reproduciendo"
