#: apps/wprs-app/qml/EditCurves.qml
msgid "Reset this curve"
msgstr "Restablecer esta curva"

#: apps/wprs-app/qml/EditDepth.qml
msgid "Downloading the model…"
msgstr "Descargando el modelo…"

#: apps/wprs-app/qml/EditDepth.qml
msgid "Loading the model…"
msgstr "Cargando el modelo…"

#: apps/wprs-app/qml/EditDepth.qml
