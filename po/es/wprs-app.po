msgstr "Elegir un color…"

#: apps/wprs-app/qml/EditEffects.qml
msgid "Normal"
msgstr "Normal"

#: apps/wprs-app/qml/EditEffects.qml
msgid "Multiply"
msgstr "Multiplicar"

#: apps/wprs-app/qml/EditEffects.qml
msgid "Screen"
msgstr "Trama"

#: apps/wprs-app/qml/EditEffects.qml
msgid "Overlay"
msgstr "Superponer"

#: apps/wprs-app/qml/EditEffects.qml
msgid "Soft light"
msgstr "Luz suave"

#: apps/wprs-app/qml/EditEffects.qml
msgid "Color"
msgstr "Color"

#: apps/wprs-app/qml/EditEffects.qml
msgid "Opacity"
msgstr "Opacidad"

#: apps/wprs-app/qml/EditEffects.qml
msgid ""
"Limit an effect to part of the picture with a mask in the list of operations."
msgstr ""
"Limita un efecto a una parte de la imagen con una máscara en la lista de "
"operaciones."

#: apps/wprs-app/qml/EditGeometry.qml
