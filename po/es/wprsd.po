#: apps/wprsd/src/words.rs
msgid "%1 (conflict)"
msgstr "%1 (conflicto)"

#: apps/wprsd/src/words.rs
msgid "Volume"
msgstr "Volumen"

#: apps/wprsd/src/words.rs
msgid "Speed"
msgstr "Velocidad"

#: apps/wprsd/src/words.rs
msgid "Start"
msgstr "Empezar en"

#: apps/wprsd/src/words.rs
msgid "Stop at"
msgstr "Parar en"

#: apps/wprsd/src/words.rs
msgid "Zoom"
msgstr "Zoom"

#: apps/wprsd/src/words.rs
msgid "Horizontal position"
msgstr "Posición horizontal"

#: apps/wprsd/src/words.rs
msgid "Vertical position"
msgstr "Posición vertical"

#: apps/wprsd/src/words.rs
msgid "0 plays to the end"
msgstr "Con 0 se reproduce hasta el final"

#: apps/wprsd/src/words.rs
msgid ""
"The scripts of this scene failed three times in a row and are off; the scene "
"goes on without them."
msgstr ""
"Los scripts de esta escena fallaron tres veces seguidas y están apagados; la "
"escena sigue sin ellos."

#: apps/wprsd/src/words.rs
msgid "A script of this scene stopped and the scene goes on without it: %1"
msgstr "Un script de esta escena se detuvo y la escena sigue sin él: %1"

#: apps/wprsd/src/words.rs
msgid "Allow"
msgstr "Permitir"

#: apps/wprsd/src/words.rs
msgid "Not now"
msgstr "Ahora no"

#: apps/wprsd/src/words.rs
msgid "Let a scene follow the sound?"
msgstr "¿Dejar que una escena siga el sonido?"

#: apps/wprsd/src/words.rs
msgid ""
"Let “%1” follow the sound that plays? The sound is turned into levels on "
"this computer; nothing is recorded, kept or sent."
msgstr ""
"¿Dejar que «%1» siga el sonido que suena? El sonido se convierte en niveles "
"en este equipo; no se graba, no se guarda y no se envía."

#: apps/wprsd/src/words.rs
msgid "Let a scene follow the pointer?"
msgstr "¿Dejar que una escena siga el puntero?"

#: apps/wprsd/src/words.rs
msgid ""
"Let “%1” follow the pointer? Only its latest position over the screen "
"reaches the scene, and it is never kept."
msgstr ""
"¿Dejar que «%1» siga el puntero? A la escena solo llega su última posición "
"sobre la pantalla, y nunca se guarda."
