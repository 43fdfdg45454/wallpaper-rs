{
  "id": "tilt_shift",
  "name": { "en": "Tilt-shift" },
  "mask_mode": "strength",
  "params": [
    { "id": "focus", "type": "float", "default": 0.5, "min": 0, "max": 1 },
    { "id": "width", "type": "float", "default": 0.15, "min": 0, "max": 1 },
    { "id": "softness", "type": "float", "default": 0.25, "min": 0, "max": 1 },
    { "id": "angle", "type": "float", "default": 0, "min": -360, "max": 360 },
    { "id": "radius", "type": "float", "default": 12, "min": 0, "max": 64 },
    { "id": "depth", "type": "texture", "default": "" }
  ],
  "passes": [
    { "entry": "fs_tilt_shift_h", "scale": 0.5, "inputs": ["previous", "asset:depth"] },
    { "entry": "fs_tilt_shift_v", "scale": 0.5, "inputs": ["previous", "asset:depth"] },
    { "entry": "fs_tilt_shift_mix", "inputs": ["input", "pass:1", "asset:depth"] }
  ],
  "cost": { "taps": 3, "passes": 3, "scale": 0.5 },
  "reach": "radius"
}
