{
  "id": "electric",
  "name": { "en": "Electric" },
  "min_fps": 30,
  "pace": { "steps": [30, 15] },
  "mask_mode": "strength",
  "params": [
    { "id": "color_a", "type": "color", "default": "#66ccff" },
    { "id": "color_b", "type": "color", "default": "#ffffff" },
    { "id": "bounds", "type": "vec2", "default": [0.4, 0.6], "min": 0, "max": 1 },
    { "id": "scale", "type": "float", "default": 2, "min": 0.1, "max": 16 },
    { "id": "smoothness", "type": "float", "default": 0.1, "min": 0, "max": 1 },
    { "id": "speed", "type": "float", "default": 1, "min": 0, "max": 8, "uses": "time" },
    { "id": "multiply", "type": "float", "default": 1, "min": 0, "max": 8 },
    { "id": "blend", "type": "blend", "default": "add" }
  ],
  "fuse": "color"
}
