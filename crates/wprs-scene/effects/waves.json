{
  "id": "waves",
  "name": { "en": "Waves" },
  "min_fps": 30,
  "uses": ["time"],
  "mask_mode": "strength",
  "params": [
    { "id": "amplitude", "type": "float", "default": 8, "min": 0, "max": 256 },
    { "id": "frequency", "type": "float", "default": 4, "min": 0, "max": 64 },
    { "id": "speed", "type": "float", "default": 1, "min": -20, "max": 20 },
    { "id": "direction", "type": "float", "default": 0, "min": -360, "max": 360 },
    { "id": "count", "type": "int", "default": 1, "min": 1, "max": 2 },
    { "id": "angle2", "type": "float", "default": 90, "min": -360, "max": 360 },
    { "id": "perspective", "type": "float", "default": 0, "min": 0, "max": 1 },
    { "id": "phase", "type": "texture", "default": "" }
  ],
  "passes": [{ "entry": "fs_waves", "inputs": ["previous", "asset:phase"] }],
  "fuse": "uv",
  "reach": "amplitude"
}
