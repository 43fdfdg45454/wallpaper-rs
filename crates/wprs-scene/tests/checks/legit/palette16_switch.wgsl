fn pal(i: i32) -> vec3<f32> { switch i { case 0: { return vec3<f32>(0.804, 0.907, 0.841); } case 1: { return vec3<f32>(0.746, 0.690, 0.178); } case 2: { return vec3<f32>(0.433, 0.158, 0.715); } case 3: { return vec3<f32>(0.668, 0.253, 0.064); } case 4: { return vec3<f32>(0.963, 0.808, 0.549); } case 5: { return vec3<f32>(0.541, 0.851, 0.453); } case 6: { return vec3<f32>(0.396, 0.339, 0.258); } case 7: { return vec3<f32>(0.024, 0.646, 0.417); } case 8: { return vec3<f32>(0.571, 0.062, 0.355); } case 9: { return vec3<f32>(0.138, 0.125, 0.259); } case 10: { return vec3<f32>(0.829, 0.398, 0.401); } case 11: { return vec3<f32>(0.612, 0.234, 0.007); } case 12: { return vec3<f32>(0.529, 0.501, 0.649); } case 13: { return vec3<f32>(0.438, 0.687, 0.731); } case 14: { return vec3<f32>(0.238, 0.495, 0.479); } case 15: { return vec3<f32>(0.225, 0.412, 0.560); } default: { return vec3<f32>(0.0); } } }
fn body_e(in: VertexOut) -> vec4<f32> { let c = tap(in.uv); var best = pal(0); var d = 1e9; for (var i = 0; i < 16; i++) { let e = distance(c.rgb, pal(i)); if (e < d) { d = e; best = pal(i); } } return vec4<f32>(best, c.a); }
@fragment fn fs_e(in: VertexOut) -> @location(0) vec4<f32> { return body_e(in) + vec4<f32>(frame.time * 1e-9); }
