{
  "params": {
    "blur": [
      { "id": "blend", "type": "blend", "default": "normal" },
      { "id": "amount", "type": "float", "default": 1, "min": 0, "max": 1 }
    ],
    "blur_motion": [
      { "id": "follow", "type": "bool", "default": false },
      { "id": "shutter", "type": "float", "default": 0.05, "min": 0, "max": 0.5 }
    ],
    "chromatic_aberration": [
      { "id": "mode", "type": "enum", "default": 0, "values": [
        { "value": 0, "label": { "en": "Expansion", "es": "Expansión" } }, { "value": 1, "label": { "en": "Directional", "es": "Direccional" } },
        { "value": 2, "label": { "en": "Radial", "es": "Radial" } }, { "value": 3, "label": { "en": "Barrel", "es": "Barril" } }] },
      { "id": "angle", "type": "float", "default": 0, "min": -360, "max": 360 }
    ],
    "film_grain": [
      { "id": "mono", "type": "bool", "default": false },
      { "id": "bias", "type": "float", "default": 0, "min": -1, "max": 1 },
      { "id": "blend", "type": "blend", "default": "overlay" }
    ],
    "flow": [
      { "id": "noise", "type": "bool", "default": false },
      { "id": "phase", "type": "texture", "default": "" }
    ],
    "god_rays": [
      { "id": "mode", "type": "enum", "default": 0, "values": [
        { "value": 0, "label": { "en": "Radial", "es": "Radial" } }, { "value": 1, "label": { "en": "Directional", "es": "Direccional" } },
        { "value": 2, "label": { "en": "Star", "es": "Estrella" } }] },
      { "id": "angle", "type": "float", "default": 90, "min": -360, "max": 360 },
      { "id": "noise", "type": "float", "default": 0, "min": 0, "max": 1 },
      { "id": "edges", "type": "int", "default": 6, "min": 2, "max": 16 }
    ],
    "iris": [{ "id": "background", "type": "bool", "default": false }],
    "lens_distort": [{ "id": "background", "type": "bool", "default": false }],
    "reflection": [{ "id": "angle", "type": "float", "default": 0, "min": -360, "max": 360 }],
    "scroll": [
      { "id": "repeat_x", "type": "bool", "default": true },
      { "id": "repeat_y", "type": "bool", "default": true }
    ],
    "shake": [
      { "id": "noise", "type": "float", "default": 0, "min": 0, "max": 1 },
      { "id": "friction", "type": "float", "default": 0, "min": 0, "max": 1 },
      { "id": "bounds", "type": "vec2", "default": [1, 1], "min": 0, "max": 1 },
      { "id": "phase", "type": "texture", "default": "" }
    ],
    "shine": [
      { "id": "blend", "type": "blend", "default": "add" },
      { "id": "gradient", "type": "texture", "default": "" }
    ],
    "sway": [
      { "id": "double", "type": "bool", "default": false },
      { "id": "phase", "type": "texture", "default": "" }
    ],
    "twirl": [
      { "id": "aspect", "type": "float", "default": 1, "min": 0.1, "max": 10 },
      { "id": "inner", "type": "float", "default": 0, "min": 0, "max": 1 },
      { "id": "noise", "type": "float", "default": 0, "min": 0, "max": 1 },
      { "id": "repeat", "type": "bool", "default": false }
    ],
    "water_ripple": [
      { "id": "perspective", "type": "float", "default": 0, "min": 0, "max": 1 },
      { "id": "reflection", "type": "texture", "default": "" },
      { "id": "tint", "type": "color", "default": "#ffffff" },
      { "id": "walls", "type": "texture", "default": "" },
      { "id": "speed", "type": "float", "default": 1, "min": 0, "max": 4 }
    ],
    "waves": [
      { "id": "count", "type": "int", "default": 1, "min": 1, "max": 2 },
      { "id": "angle2", "type": "float", "default": 90, "min": -360, "max": 360 },
      { "id": "perspective", "type": "float", "default": 0, "min": 0, "max": 1 },
      { "id": "phase", "type": "texture", "default": "" }
    ]
  },
  "effects": [
    { "id": "blend_gradient", "name": { "en": "Gradient blend" }, "mask_mode": "strength",
      "params": [
        { "id": "texture", "type": "texture", "default": "" },
        { "id": "map", "type": "texture", "default": "" },
        { "id": "progress", "type": "float", "default": 0.5, "min": 0, "max": 1 },
        { "id": "softness", "type": "float", "default": 0.1, "min": 0, "max": 1 }],
      "passes": [{ "entry": "fs_blend_gradient", "inputs": ["previous", "asset:texture", "asset:map"] }] },
    { "id": "caustics", "name": { "en": "Caustics" }, "mask_mode": "strength",
      "params": [
        { "id": "color", "type": "color", "default": "#cfefff" },
        { "id": "scale", "type": "float", "default": 2, "min": 0.1, "max": 16 },
        { "id": "speed", "type": "float", "default": 0.5, "min": 0, "max": 8, "uses": "time" },
        { "id": "strength", "type": "float", "default": 0.6, "min": 0, "max": 4 },
        { "id": "perspective", "type": "float", "default": 0, "min": 0, "max": 1 }],
      "fuse": "color" },
    { "id": "displace", "name": { "en": "Displace" }, "mask_mode": "strength",
      "params": [
        { "id": "map", "type": "texture", "default": "" },
        { "id": "mode", "type": "enum", "default": 0, "values": [
          { "value": 0, "label": { "en": "Normals", "es": "Normales" } }, { "value": 1, "label": { "en": "Offsets", "es": "Desplazamientos" } }] },
        { "id": "scale", "type": "float", "default": 1, "min": 0.1, "max": 16 },
        { "id": "strength", "type": "float", "default": 8, "min": 0, "max": 256 },
        { "id": "scroll", "type": "vec2", "default": [0, 0], "min": -4, "max": 4, "uses": "time" },
        { "id": "ratio", "type": "float", "default": 1, "min": 0.1, "max": 10 }],
      "passes": [{ "entry": "fs_displace", "inputs": ["previous", "asset:map"] }], "reach": "strength" },
    { "id": "electric", "name": { "en": "Electric" }, "mask_mode": "strength",
      "params": [
        { "id": "color_a", "type": "color", "default": "#66ccff" },
        { "id": "color_b", "type": "color", "default": "#ffffff" },
        { "id": "bounds", "type": "vec2", "default": [0.4, 0.6], "min": 0, "max": 1 },
        { "id": "scale", "type": "float", "default": 2, "min": 0.1, "max": 16 },
        { "id": "smoothness", "type": "float", "default": 0.1, "min": 0, "max": 1 },
        { "id": "speed", "type": "float", "default": 1, "min": 0, "max": 8, "uses": "time" },
        { "id": "multiply", "type": "float", "default": 1, "min": 0, "max": 8 },
        { "id": "blend", "type": "blend", "default": "add" }],
      "fuse": "color" },
    { "id": "fire", "name": { "en": "Fire" }, "mask_mode": "strength",
      "params": [
        { "id": "speed", "type": "float", "default": 1, "min": 0, "max": 8, "uses": "time" },
        { "id": "strength", "type": "float", "default": 8, "min": 0, "max": 64 },
        { "id": "scale", "type": "float", "default": 3, "min": 0.1, "max": 16 },
        { "id": "gradient", "type": "texture", "default": "" }],
      "passes": [{ "entry": "fs_fire", "inputs": ["previous", "asset:gradient"] }], "reach": "strength" },
    { "id": "fluid", "name": { "en": "Fluid" }, "mask_mode": "strength",
      "params": [
        { "id": "render", "type": "enum", "default": 0, "values": [
          { "value": 0, "label": { "en": "Gradient", "es": "Degradado" } }, { "value": 1, "label": { "en": "Emitter color", "es": "Color del emisor" } },
          { "value": 2, "label": { "en": "Background color", "es": "Color de fondo" } }, { "value": 3, "label": { "en": "Distortion", "es": "Distorsión" } }] },
        { "id": "gradient", "type": "texture", "default": "" },
        { "id": "color", "type": "color", "default": "#ffffff" },
        { "id": "velocity_decay", "type": "float", "default": 0.98, "min": 0, "max": 1 },
        { "id": "dye_decay", "type": "float", "default": 0.97, "min": 0, "max": 1 },
        { "id": "push", "type": "float", "default": 1, "min": 0, "max": 8, "uses": "cursor" },
        { "id": "source", "type": "position", "default": [0.5, 0.9] },
        { "id": "source_angle", "type": "float", "default": -90, "min": -360, "max": 360 },
        { "id": "source_strength", "type": "float", "default": 0, "min": 0, "max": 64 },
        { "id": "line_from", "type": "position", "default": [0.3, 1] },
        { "id": "line_to", "type": "position", "default": [0.7, 1] },
        { "id": "line_strength", "type": "float", "default": 0, "min": 0, "max": 64 },
        { "id": "blend", "type": "blend", "default": "normal" },
        { "id": "perspective", "type": "float", "default": 0, "min": 0, "max": 1 },
        { "id": "opaque", "type": "bool", "default": false }],
      "state": { "scale": 0.25, "settle": 6 },
      "passes": [
        { "entry": "fs_fluid_step", "scale": 0.25, "inputs": ["state"], "output": "state" },
        { "entry": "fs_fluid", "inputs": ["input", "state"] }],
      "cost": { "taps": 8, "passes": 6, "scale": 0.5 }, "quality": { "q1": { "scale": 0.5 } } },
    { "id": "glitter", "name": { "en": "Glitter" }, "mask_mode": "strength",
      "params": [
        { "id": "density", "type": "float", "default": 0.3, "min": 0, "max": 1 },
        { "id": "size", "type": "float", "default": 2, "min": 0.5, "max": 16 },
        { "id": "speed", "type": "float", "default": 1, "min": 0, "max": 8, "uses": "time" },
        { "id": "color", "type": "color", "default": "#ffffff" }],
      "fuse": "color", "pace": { "rate": "speed" } },
    { "id": "lens_flare", "name": { "en": "Lens flare" },
      "params": [
        { "id": "source", "type": "position", "default": [0.3, 0.3] },
        { "id": "follow", "type": "bool", "default": false, "uses": "cursor" },
        { "id": "intensity", "type": "float", "default": 1, "min": 0, "max": 4 },
        { "id": "ghosts", "type": "int", "default": 4, "min": 0, "max": 8 },
        { "id": "halo", "type": "float", "default": 0.3, "min": 0, "max": 1 },
        { "id": "color", "type": "color", "default": "#ffffff" }],
      "passes": [{ "entry": "fs_lens_flare_bright", "scale": 0.5 }, { "entry": "fs_lens_flare", "inputs": ["input", "pass:0"] }],
      "cost": { "taps": 4, "passes": 2, "scale": 0.5 } },
    { "id": "local_contrast", "name": { "en": "Local contrast" }, "mask_mode": "strength",
      "params": [
        { "id": "radius", "type": "float", "default": 8, "min": 1, "max": 64 },
        { "id": "amount", "type": "float", "default": 0.5, "min": 0, "max": 4 },
        { "id": "luma_only", "type": "bool", "default": true }],
      "passes": [
        { "entry": "fs_local_contrast_h", "scale": 0.5 }, { "entry": "fs_local_contrast_v", "scale": 0.5 },
        { "entry": "fs_local_contrast", "inputs": ["input", "pass:1"] }],
      "cost": { "taps": 3, "passes": 3, "scale": 0.5 }, "reach": "radius" },
    { "id": "pulse", "name": { "en": "Pulse" }, "mask_mode": "strength",
      "params": [
        { "id": "what", "type": "enum", "default": 0, "values": [
          { "value": 0, "label": { "en": "Brightness", "es": "Brillo" } }, { "value": 1, "label": { "en": "Color", "es": "Color" } },
          { "value": 2, "label": { "en": "Opacity", "es": "Opacidad" } }] },
        { "id": "speed", "type": "float", "default": 1, "min": 0, "max": 16, "uses": "time" },
        { "id": "bounds", "type": "vec2", "default": [0, 1], "min": 0, "max": 4 },
        { "id": "tint_low", "type": "color", "default": "#000000" },
        { "id": "tint_high", "type": "color", "default": "#ffffff" },
        { "id": "noise", "type": "float", "default": 0, "min": 0, "max": 1 },
        { "id": "noise_speed", "type": "float", "default": 1, "min": 0, "max": 16 },
        { "id": "phase", "type": "texture", "default": "" },
        { "id": "audio_band", "type": "int", "default": 0, "min": 0, "max": 64, "uses": "audio" }],
      "fuse": "color" },
    { "id": "reveal", "name": { "en": "Reveal" }, "mask_mode": "strength",
      "params": [
        { "id": "texture", "type": "texture", "default": "" },
        { "id": "shape", "type": "enum", "default": 0, "values": [
          { "value": 0, "label": { "en": "Circle", "es": "Círculo" } }, { "value": 1, "label": { "en": "Ellipse", "es": "Elipse" } }] },
        { "id": "radius", "type": "float", "default": 0.15, "min": 0, "max": 1 },
        { "id": "softness", "type": "float", "default": 0.3, "min": 0, "max": 1 },
        { "id": "follow", "type": "bool", "default": false, "uses": "cursor" },
        { "id": "invert", "type": "bool", "default": false },
        { "id": "center", "type": "position", "default": [0.5, 0.5] }],
      "passes": [{ "entry": "fs_reveal", "inputs": ["previous", "asset:texture"] }] },
    { "id": "spin", "name": { "en": "Spin" }, "mask_mode": "strength",
      "params": [
        { "id": "center", "type": "position", "default": [0.5, 0.5] },
        { "id": "angle", "type": "float", "default": 0, "min": -360, "max": 360 },
        { "id": "speed", "type": "float", "default": 0, "min": -720, "max": 720, "uses": "time" },
        { "id": "radius", "type": "float", "default": 0.5, "min": 0, "max": 2 }],
      "fuse": "uv" },
    { "id": "trail", "name": { "en": "Motion trail" },
      "params": [{ "id": "persistence", "type": "float", "default": 0.8, "min": 0, "max": 0.99 }],
      "state": { "scale": 1, "settle": 2 },
      "passes": [
        { "entry": "fs_trail_step", "inputs": ["input", "state"], "output": "state" },
        { "entry": "fs_trail", "inputs": ["state"] }],
      "cost": { "taps": 2, "passes": 2, "scale": 1 } },
    { "id": "transform", "name": { "en": "Transform" },
      "params": [
        { "id": "offset", "type": "vec2", "default": [0, 0], "min": -2, "max": 2 },
        { "id": "scale", "type": "vec2", "default": [1, 1], "min": 0.01, "max": 16 },
        { "id": "angle", "type": "float", "default": 0, "min": -360, "max": 360 },
        { "id": "skew", "type": "vec2", "default": [0, 0], "min": -89, "max": 89 },
        { "id": "pivot", "type": "position", "default": [0.5, 0.5] }],
      "fuse": "uv" },
    { "id": "vhs", "name": { "en": "VHS" }, "mask_mode": "strength",
      "params": [
        { "id": "strength", "type": "float", "default": 0.5, "min": 0, "max": 1 },
        { "id": "speed", "type": "float", "default": 1, "min": 0, "max": 8, "uses": "time" },
        { "id": "noise", "type": "float", "default": 0.3, "min": 0, "max": 1 },
        { "id": "aberration", "type": "float", "default": 2, "min": 0, "max": 16 }],
      "passes": [{ "entry": "fs_vhs" }] }
  ]
}
