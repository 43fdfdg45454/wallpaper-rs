# URL publica del servidor, tal como la escriben los clientes (obligatoria)
WPRS_PUBLIC_URL=https://fondos.example.org
# Version de la imagen (latest si se omite)
WPRS_VERSION=latest
# Direccion y puerto del equipo en que escucha el contenedor
WPRS_BIND=127.0.0.1:8080
# Nombre de la instancia
WPRS_NAME=wallpaper-rs
# Altas de cuentas: closed, invite u open
WPRS_REGISTRATION=invite
# Publicar subidas sin revision: never, trusted o all
WPRS_AUTO_PUBLISH=trusted
# Licencias SPDX aceptadas en las subidas, separadas por comas
WPRS_LICENSES=CC0-1.0,CC-BY-4.0,CC-BY-SA-4.0
# Tamano maximo de un paquete en MiB (cuida client_max_body_size del proxy)
WPRS_PACKAGE_MAX_MIB=256
# Almacenamiento de paquetes por cuenta, en MiB
WPRS_USER_QUOTA_MIB=2048
# Subidas por cuenta y dia
WPRS_UPLOADS_PER_DAY=20
# Registros de sincronizacion por cuenta, en MiB
WPRS_SYNC_QUOTA_MIB=64
# Archivos privados por cuenta, en MiB
WPRS_FILES_QUOTA_MIB=1024
# Dias de vida de cada indice firmado (1 a 14)
WPRS_ENTRY_DAYS=7
# Cada cuantas horas como maximo se vuelve a firmar el indice
WPRS_RESIGN_HOURS=24
# Segundos de espera tras una decision de moderacion antes de firmar
WPRS_PUBLISH_DELAY_SECS=30
# Responsable del servicio, para las paginas legales
WPRS_LEGAL_OPERATOR=
# Contacto de las paginas legales
WPRS_LEGAL_CONTACT=
# Jurisdiccion de las paginas legales
WPRS_LEGAL_JURISDICTION=
# Agente DMCA de las paginas legales
WPRS_LEGAL_DMCA_AGENT=
# Registro de abusos con la IP de los clientes: off, prefix o full
WPRS_LOG_CLIENTS=off
# Dias que se guarda ese registro (1 a 30)
WPRS_LOG_CLIENTS_DAYS=7
# Dias que un aviso legal guarda los datos de quien lo envia (1 a 730)
WPRS_NOTICE_DAYS=180
# Dias que se guarda un paquete retirado como prueba (1 a 3650)
WPRS_TAKEDOWN_DAYS=90
# Limites de peticiones en memoria: true o false
WPRS_RATE_LIMITS=true
# off, o self-signed para servir HTTPS con certificado propio
WPRS_TLS=off
# Anunciar el servidor en la red local por mDNS: true o false
WPRS_ADVERTISE=false
# Filtro del registro (por ejemplo info o debug)
WPRS_LOG=info
# Inicio de sesion unico opcional: descomentar las cuatro lineas para activarlo
# WPRS_OIDC_ISSUER=https://id.example.org
# WPRS_OIDC_CLIENT_ID=
# WPRS_OIDC_CLIENT_SECRET=
# WPRS_OIDC_AUTO_PROVISION=false
