import QtQuick
import QtQuick.Layouts
import QtQuick.Controls as QQC2
import org.kde.kirigami as Kirigami
import io.github.wallpaper_rs.app

ColumnLayout {
    id: palette

    required property var tint

    Flow {
        Layout.fillWidth: true
        spacing: Kirigami.Units.smallSpacing

        Repeater {
            model: tint.colors

            delegate: RowLayout {
                required property string modelData
                required property int index

                SceneColor {
                    hex: modelData
                    onPicked: hex => {
                        const c = tint.colors.slice();
                        c[index] = hex;
                        tint.put("palette", Object.assign({}, tint.init.palette, {
                                "colors": c
                            }), false);
                    }
                }

                QQC2.ToolButton {
                    icon.name: "list-remove"
                    text: App.tr("Remove the color")
                    display: QQC2.AbstractButton.IconOnly
                    enabled: tint.colors.length > 1
                    onClicked: tint.put("palette", Object.assign({}, tint.init.palette, {
                            "colors": tint.colors.filter((_, k) => k !== index)
                        }), false)
                }
            }
        }

        QQC2.ToolButton {
            icon.name: "list-add"
            text: App.tr("Add a color")
            onClicked: tint.put("palette", Object.assign({}, tint.init.palette, {
                    "colors": tint.colors.concat([tint.colors[tint.colors.length - 1] ?? "#ffffff"])
                }), false)
        }
    }

    SceneSliders {
        Layout.fillWidth: true
        value: {
            const n = tint.init.palette?.noise ?? [0, 0, 0];
            return {
                "h": n[0],
                "s": n[1],
                "v": n[2]
            };
        }
        rows: [["h", App.tr("Hue noise"), 0, 1, 0.01], ["s", App.tr("Saturation noise"), 0, 1, 0.01], ["v", App.tr("Value noise"), 0, 1, 0.01]]
        onEdited: (key, v) => {
            const n = (tint.init.palette?.noise ?? [0, 0, 0]).slice();
            n[["h", "s", "v"].indexOf(key)] = v;
            tint.put("palette", Object.assign({}, tint.init.palette, {
                    "noise": n
                }), true);
        }
    }
}
