    function language(code) {
        const parts = String(code ?? "").split("-");
        const name = languages[parts[0].toLowerCase()];
        return name ? name + (parts.length > 1 ? " (" + parts.slice(1).join("-") + ")" : "") : parts.join("-");
    }
