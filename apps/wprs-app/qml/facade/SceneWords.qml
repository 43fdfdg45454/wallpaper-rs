    function label(key, pointer) {
        const text = String(key ?? "");
        const parent = String(pointer ?? "").split("/").slice(-2, -1)[0];
        const named = words[parent + "." + text] ?? ManifestWords.words[parent + "." + text] ?? words[text] ?? ManifestWords.words[text];
        return named ?? (text.charAt(0).toUpperCase() + text.slice(1)).replace(/_/g, " ");
    }

    function kind(key) {
        return kinds[key] ?? label(key);
    }

    function effect(id) {
        return effects[id] ?? label(id);
    }

    function easing(name) {
        const parts = /^(in_out|in|out)_(.*)$/.exec(name);
        if (!parts)
            return values[name] ?? label(name);
        const curve = curves[parts[2]] ?? parts[2];
        return parts[1] === "in" ? App.tr("Ease in (%1)").arg(curve) : parts[1] === "out" ? App.tr("Ease out (%1)").arg(curve) : App.tr("Ease in and out (%1)").arg(curve);
    }

    function value(option) {
        const text = String(option ?? "");
        return values[text] ?? ManifestWords.values[text] ?? kinds[text] ?? effects[text] ?? (words[text] ? label(text) : easing(text));
    }

    function binding(bound) {
        const found = Object.keys(sources).find(source => (bound ?? {})[source] !== undefined) ?? "keys";
        const detail = found === "prop" ? bound.prop : ["audio", "cursor"].includes(found) ? value(bound[found]) : "";
        return sources[found] + (detail ? " · " + detail : "");
    }
