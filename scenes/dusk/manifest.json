{
  "schema": "wallpaper-rs.wpak/2",
  "id": "io.github.wallpaper_rs.example.dusk",
  "version": "1.1.0",
  "default_locale": "en",
  "title": "@title",
  "description": "@description",
  "changes": "@changes",
  "strings": {
    "en": {
      "title": "Dusk hills",
      "description": "Layered hills under a low sun.\n\n- **Blend modes** and a masked reflection\n- A timeline that brings the light in\n- Depth that follows the pointer once you allow it\n- Settings for the time of day, the light and a caption",
      "changes": "Describes itself in English and Spanish and declares its rating and the inputs it uses.",
      "look": "Look", "mood": "Time of day", "dusk": "Dusk", "night": "Night", "stars": "Stars",
      "light": "Light color", "warmth": "Light strength", "sun_size": "Sun size", "vignette": "Dark corners",
      "depth": "Depth", "pointer": "Follow the pointer", "orbit": "Slow orbit", "off": "Off",
      "words": "Caption", "caption": "Text", "caption_help": "Shown in the lower left corner.",
      "caption_color": "Text color", "golden": "Golden hour", "moonlight": "Moonlight"
    },
    "es": {
      "title": "Colinas al atardecer",
      "description": "Colinas en capas bajo el sol del atardecer.\n\n- **Modos de fusión** y un reflejo con máscara\n- Una línea de tiempo que hace entrar la luz\n- Profundidad que sigue al puntero cuando lo permites\n- Ajustes para el momento del día, la luz y un rótulo",
      "changes": "Se describe en inglés y en español y declara su clasificación y las entradas que usa.",
      "look": "Aspecto", "mood": "Momento del día", "dusk": "Atardecer", "night": "Noche", "stars": "Estrellas",
      "light": "Color de la luz", "warmth": "Intensidad de la luz", "sun_size": "Tamaño del sol",
      "vignette": "Esquinas oscuras", "depth": "Profundidad", "pointer": "Seguir al puntero", "orbit": "Órbita lenta",
      "off": "Apagada", "words": "Rótulo", "caption": "Texto", "caption_help": "Se muestra en la esquina inferior izquierda.",
      "caption_color": "Color del texto", "golden": "Hora dorada", "moonlight": "Luz de luna"
    }
  },
  "authors": ["wallpaper-rs contributors"],
  "license": "CC0-1.0",
  "origin": { "kind": "original" },
  "content": { "rating": "general" },
  "photosensitive": false,
  "kind": "scene",
  "entry": "scene.json",
  "previews": { "thumbnail": "preview.jpg" },
  "tags": ["example", "landscape", "depth"],
  "requires": { "features": ["inputs.pointer"] },
  "inputs": ["pointer"],
  "properties": {
    "look": { "type": "group", "label": "@look" },
    "mood": { "type": "combo", "group": "look", "order": 1, "default": "dusk", "label": "@mood",
              "options": [{ "value": "dusk", "label": "@dusk" }, { "value": "night", "label": "@night" }] },
    "stars": { "type": "bool", "group": "look", "order": 2, "default": true, "label": "@stars" },
    "light": { "type": "color", "group": "look", "order": 3, "default": "#ff9a5c", "label": "@light" },
    "warmth": { "type": "slider", "group": "look", "order": 4, "min": 0, "max": 1, "step": 0.05, "default": 0.35,
                "label": "@warmth" },
    "sun_size": { "type": "slider", "group": "look", "order": 5, "min": 0.5, "max": 1.5, "step": 0.05, "default": 1,
                  "unit": "×", "label": "@sun_size" },
    "vignette": { "type": "bool", "group": "look", "order": 6, "default": true, "label": "@vignette" },
    "depth": { "type": "combo", "group": "look", "order": 7, "default": "pointer", "label": "@depth",
               "options": [{ "value": "pointer", "label": "@pointer" }, { "value": "orbit", "label": "@orbit" },
                           { "value": "off", "label": "@off" }] },
    "words": { "type": "group", "order": 1, "label": "@words" },
    "caption": { "type": "text", "group": "words", "order": 1, "default": "", "max_len": 40,
                 "label": "@caption", "help": "@caption_help" },
    "caption_color": { "type": "color", "group": "words", "order": 2, "default": "#ffffffd0", "alpha": true,
                       "label": "@caption_color" }
  },
  "presets": [
    { "id": "golden", "label": "@golden", "values": { "mood": "dusk", "light": "#ffb347", "warmth": 0.55 } },
    { "id": "moonlight", "label": "@moonlight", "values": { "mood": "night", "stars": true, "light": "#7f9cff", "warmth": 0.2 } }
  ]
}
