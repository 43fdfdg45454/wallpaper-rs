{
  "schema": "wallpaper-rs.scene/1",
  "canvas": { "size": [1920, 1080], "fit": "fill", "background": "#1b1630" },
  "clock": { "max_fps": "display", "poster_time": 6 },
  "timelines": [{ "id": "rise", "duration": 5 }],
  "assets": { "depth": { "path": "depth.png", "linear": true } },
  "layers": [
    { "id": "sky", "type": "shape", "shape": { "rect": { "size": [1920, 1080] } },
      "visible": { "prop": "mood", "map": { "dusk": true, "night": false } },
      "gradient": { "stops": [[0, "#2b2f5c"], [0.5, "#b8607c"], [0.75, "#f0a06a"], [1, "#f8d9a2"]] } },
    { "id": "night", "type": "shape", "shape": { "rect": { "size": [1920, 1080] } },
      "visible": { "prop": "mood", "map": { "dusk": false, "night": true } },
      "gradient": { "stops": [[0, "#03050f"], [0.7, "#1a2246"], [1, "#3a3e6a"]] } },
    { "id": "stars", "type": "group", "visible": { "prop": "stars" },
      "opacity": { "prop": "mood", "map": { "dusk": 0.35, "night": 1 } },
      "layers": [
        { "id": "s1", "type": "shape", "shape": { "star": { "points": 4, "size": 9, "inner": 0.25 } }, "fill": "#fff8e7", "transform": { "position": [220, 140] } },
        { "id": "s2", "type": "shape", "shape": { "star": { "points": 4, "size": 6, "inner": 0.25 } }, "fill": "#fff8e7", "transform": { "position": [520, 260] } },
        { "id": "s3", "type": "shape", "shape": { "star": { "points": 4, "size": 11, "inner": 0.25 } }, "fill": "#fff8e7", "transform": { "position": [860, 110] } },
        { "id": "s4", "type": "shape", "shape": { "star": { "points": 4, "size": 7, "inner": 0.25 } }, "fill": "#fff8e7", "transform": { "position": [1240, 210] } },
        { "id": "s5", "type": "shape", "shape": { "star": { "points": 4, "size": 10, "inner": 0.25 } }, "fill": "#fff8e7", "transform": { "position": [1580, 90] } },
        { "id": "s6", "type": "shape", "shape": { "star": { "points": 4, "size": 6, "inner": 0.25 } }, "fill": "#fff8e7", "transform": { "position": [1790, 300] } }
      ] },
    { "id": "glow", "type": "shape", "shape": { "ellipse": { "size": [1100, 1100] } }, "blend": "screen",
      "gradient": { "radial": true, "from": [0.5, 0.5], "to": [1, 0.5], "stops": [[0, "#ffd9a0b0"], [0.3, "#ffd9a03c"], [0.65, "#ffd9a008"], [1, "#ffd9a000"]] },
      "opacity": { "prop": "warmth", "scale": 1.6, "clamp": [0, 1] },
      "transform": { "position": { "keys": [[0, [960, 980], "out_cubic"], [5, [960, 650]]], "timeline": "rise" } } },
    { "id": "sun", "type": "shape", "shape": { "ellipse": { "size": [190, 190] } },
      "fill": { "prop": "mood", "map": { "dusk": "#ffd27a", "night": "#e6ecf7" } },
      "transform": { "position": { "keys": [[0, [960, 980], "out_cubic"], [5, [960, 650]]], "timeline": "rise" },
                     "scale": { "prop": "sun_size" } } },
    { "id": "far", "type": "shape", "shape": { "ellipse": { "size": [2700, 700] } }, "fill": "#8a5a78", "transform": { "position": [760, 1060] } },
    { "id": "lake", "type": "shape", "shape": { "rect": { "size": [1920, 190] } }, "transform": { "position": [960, 985] },
      "gradient": { "stops": [[0, "#d39a92"], [1, "#4f416a"]] } },
    { "id": "reflection", "type": "shape", "shape": { "ellipse": { "size": [150, 320] } }, "fill": "#ffe2a0", "opacity": 0.55,
      "transform": { "position": [960, 960] }, "mask": { "layer": "lake" },
      "effects": [{ "effect": "blur_motion", "params": { "angle": 90, "length": 48 } }] },
    { "id": "left", "type": "shape", "shape": { "ellipse": { "size": [1400, 520] } }, "fill": "#3d2747", "transform": { "position": [180, 1110] } },
    { "id": "right", "type": "shape", "shape": { "ellipse": { "size": [1500, 440] } }, "fill": "#2c1c36", "transform": { "position": [1740, 1130] } },
    { "id": "tint", "type": "solid", "color": { "prop": "light" }, "blend": "soft_light", "opacity": { "prop": "warmth" } },
    { "id": "relief", "type": "adjustment", "effects": [{ "effect": "depth_parallax",
      "enabled": { "prop": "depth", "map": { "pointer": true, "orbit": true, "off": false } },
      "params": { "depth": "depth", "strength": 18, "focus": 0.3, "overscan": 1.02,
                  "follow": { "prop": "depth", "map": { "pointer": true, "orbit": false, "off": false } },
                  "orbit": { "prop": "depth", "map": { "pointer": false, "orbit": true, "off": false } } } }] },
    { "id": "caption", "type": "text", "text": { "prop": "caption" }, "font": "serif", "size": 56, "align": "left",
      "color": { "prop": "caption_color" }, "anchor": "bottom_left", "transform": { "position": [72, -64] } },
    { "id": "post", "type": "adjustment", "effects": [{ "effect": "vignette", "enabled": { "prop": "vignette" }, "params": { "intensity": 0.4 } }] }
  ]
}
