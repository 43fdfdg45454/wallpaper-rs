[Unit]
Description=wallpaper-rs wallpaper daemon
Documentation=https://github.com/43fdfdg45454/wallpaper-rs
PartOf=graphical-session.target
After=graphical-session.target pipewire.service
Wants=pipewire.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=io.github.wallpaper_rs.Daemon
ExecStart=@BINDIR@/wprsd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
